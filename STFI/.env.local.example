# Redis (provisioned via Vercel → Storage → Redis)
# Locally: run `vercel env pull .env.development.local` after connecting the DB
# to your project, and the REDIS_URL value will be populated automatically.
REDIS_URL=your_redis_url_here

# Email Configuration (using Resend or SendGrid, or your SMTP provider)
NEXT_PUBLIC_MAGIC_LINK_EXPIRY=15m
MAGIC_LINK_SECRET=your_secret_key_here

# Email provider (choose one: resend, sendgrid, or smtp)
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key_here

# Or for SMTP:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_password_here
# SMTP_FROM=noreply@example.com

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
